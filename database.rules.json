{
  "rules": {
    "sessions": {
      "$id": {
        ".read": "auth != null && (root.child('tournaments/_admins/'+auth.uid).exists() || root.child('tournaments/_members/'+data.child('teamSlug').val()+'/'+auth.uid).exists() || (!data.child('teamSlug').exists() && root.child('tournaments/_teamMembers/'+auth.uid).exists()))",
        ".write": "auth != null && (root.child('tournaments/_admins/'+auth.uid).exists() || root.child('tournaments/_members/'+newData.child('teamSlug').val()+'/'+auth.uid).exists() || root.child('tournaments/_members/'+data.child('teamSlug').val()+'/'+auth.uid).exists() || (!newData.child('teamSlug').exists() && !data.child('teamSlug').exists() && root.child('tournaments/_teamMembers/'+auth.uid).exists()))"
      }
    },
    "tournaments": {
      "_admins": {
        ".read": "auth != null && root.child('tournaments/_admins/'+auth.uid).exists()",
        ".write": "auth != null && root.child('tournaments/_admins/'+auth.uid).exists()",
        "$uid": {
          ".read": "auth != null && ($uid === auth.uid || root.child('tournaments/_admins/'+auth.uid).exists())"
        }
      },
      "_members": {
        ".read": "auth != null && root.child('tournaments/_admins/'+auth.uid).exists()",
        ".write": "auth != null && root.child('tournaments/_admins/'+auth.uid).exists()"
      },
      "_teamMembers": {
        ".read": "auth != null && root.child('tournaments/_admins/'+auth.uid).exists()",
        ".write": "auth != null && root.child('tournaments/_admins/'+auth.uid).exists()"
      },
      "_myTournaments": {
        ".write": "auth != null && root.child('tournaments/_admins/'+auth.uid).exists()",
        "$uid": {
          ".read": "auth != null && ($uid === auth.uid || root.child('tournaments/_admins/'+auth.uid).exists())",
          ".write": "auth != null && ($uid === auth.uid || root.child('tournaments/_admins/'+auth.uid).exists())"
        }
      },
      "_coaches": {
        ".read": "auth != null && root.child('tournaments/_admins/'+auth.uid).exists()",
        ".write": "auth != null && root.child('tournaments/_admins/'+auth.uid).exists()"
      },
      "_owners": {
        ".read": "auth != null && root.child('tournaments/_admins/'+auth.uid).exists()",
        "$slug": {
          ".read": "auth != null && (root.child('tournaments/_admins/'+auth.uid).exists() || root.child('tournaments/_owners/'+$slug+'/'+auth.uid).exists())",
          "$uid": {
            ".write": "auth != null && (($uid === auth.uid && !root.child('tournaments/_owners/'+$slug).exists()) || root.child('tournaments/_owners/'+$slug+'/'+auth.uid).exists() || root.child('tournaments/_admins/'+auth.uid).exists())"
          }
        }
      },
      "_profileOwners": {
        ".read": "auth != null && root.child('tournaments/_admins/'+auth.uid).exists()",
        ".write": "auth != null && root.child('tournaments/_admins/'+auth.uid).exists()"
      },
      "_users": {
        ".read": "auth != null && root.child('tournaments/_admins/'+auth.uid).exists()",
        "$uid": {
          ".read": "auth != null && ($uid === auth.uid || root.child('tournaments/_admins/'+auth.uid).exists())",
          ".write": "auth != null && ($uid === auth.uid || root.child('tournaments/_admins/'+auth.uid).exists())"
        }
      },
      "_players": {
        ".read": "auth != null && (root.child('tournaments/_admins/'+auth.uid).exists() || root.child('tournaments/_teamMembers/'+auth.uid).exists())",
        ".write": "auth != null && root.child('tournaments/_admins/'+auth.uid).exists()"
      },
      "_registry": {
        ".read": "auth != null && root.child('tournaments/_admins/'+auth.uid).exists()",
        "$id": {
          ".read": "auth != null && (root.child('tournaments/_admins/'+auth.uid).exists() || root.child('tournaments/_members/'+data.child('dataSlug').val()+'/'+auth.uid).exists() || root.child('tournaments/_owners/'+data.child('dataSlug').val()+'/'+auth.uid).exists())",
          ".write": "auth != null && (!data.exists() || root.child('tournaments/_admins/'+auth.uid).exists() || root.child('tournaments/_owners/'+data.child('dataSlug').val()+'/'+auth.uid).exists())"
        }
      },
      "$slug": {
        ".read": "auth != null && (root.child('tournaments/_admins/'+auth.uid).exists() || root.child('tournaments/_members/'+$slug+'/'+auth.uid).exists() || root.child('tournaments/_owners/'+$slug+'/'+auth.uid).exists())",
        ".write": "auth != null && (root.child('tournaments/_admins/'+auth.uid).exists() || root.child('tournaments/_owners/'+$slug+'/'+auth.uid).exists())",
        "profiles": {
          "$armyKey": {
            ".write": "auth != null && (root.child('tournaments/_admins/'+auth.uid).exists() || root.child('tournaments/_owners/'+$slug+'/'+auth.uid).exists() || root.child('tournaments/_profileOwners/'+$slug+'/'+$armyKey).val() === auth.uid)"
          }
        },
        "warmups": {
          "$armyKey": {
            ".write": "auth != null && (root.child('tournaments/_admins/'+auth.uid).exists() || root.child('tournaments/_owners/'+$slug+'/'+auth.uid).exists() || root.child('tournaments/_profileOwners/'+$slug+'/'+$armyKey).val() === auth.uid)"
          }
        },
        "rounds": {
          ".write": "auth != null && (root.child('tournaments/_admins/'+auth.uid).exists() || root.child('tournaments/_owners/'+$slug+'/'+auth.uid).exists() || root.child('tournaments/_members/'+$slug+'/'+auth.uid).exists())"
        },
        "activeSessionId": {
          ".write": "auth != null && (root.child('tournaments/_admins/'+auth.uid).exists() || root.child('tournaments/_owners/'+$slug+'/'+auth.uid).exists() || root.child('tournaments/_members/'+$slug+'/'+auth.uid).exists())"
        },
        "currentRound": {
          ".write": "auth != null && (root.child('tournaments/_admins/'+auth.uid).exists() || root.child('tournaments/_owners/'+$slug+'/'+auth.uid).exists() || root.child('tournaments/_members/'+$slug+'/'+auth.uid).exists())"
        },
        "roster": {
          ".read": "auth != null && root.child('tournaments/'+$slug+'/_join/open').val() === true",
          "armies": {
            "$i": {
              "claimedByUid": {
                ".write": "auth != null && (root.child('tournaments/_admins/'+auth.uid).exists() || root.child('tournaments/_owners/'+$slug+'/'+auth.uid).exists() || (newData.val() === auth.uid && !data.exists() && root.child('tournaments/'+$slug+'/_join/open').val() === true))"
              },
              "player": {
                ".write": "auth != null && (root.child('tournaments/_admins/'+auth.uid).exists() || root.child('tournaments/_owners/'+$slug+'/'+auth.uid).exists() || root.child('tournaments/'+$slug+'/roster/armies/'+$i+'/claimedByUid').val() === auth.uid)"
              }
            }
          }
        },
        "_join": {
          ".write": "auth != null && (root.child('tournaments/_admins/'+auth.uid).exists() || root.child('tournaments/_owners/'+$slug+'/'+auth.uid).exists())"
        }
      }
    },
    "estimates": {
      "_library": {
        ".read": "auth != null && (root.child('tournaments/_admins/'+auth.uid).exists() || root.child('tournaments/_teamMembers/'+auth.uid).exists())",
        ".write": "auth != null && (root.child('tournaments/_admins/'+auth.uid).exists() || root.child('tournaments/_teamMembers/'+auth.uid).exists())"
      },
      "$node": {
        ".read": "auth != null && (root.child('tournaments/_admins/'+auth.uid).exists() || root.child('tournaments/_members/'+$node+'/'+auth.uid).exists() || root.child('tournaments/_owners/'+$node+'/'+auth.uid).exists())",
        ".write": "auth != null && (root.child('tournaments/_admins/'+auth.uid).exists() || root.child('tournaments/_members/'+$node+'/'+auth.uid).exists() || root.child('tournaments/_owners/'+$node+'/'+auth.uid).exists())"
      }
    }
  }
}
